# Copia este ficheiro para .env e preenche os valores.
# .env está no gitignore e NUNCA deve ser enviado ao repositório.
#
# SEGURANÇA F-11: A SUPABASE_ANON_KEY deve ser rotacionada regularmente.
# Rotaciona em: Supabase Dashboard → Project Settings → API → Reset anon key
# Após rotação: atualiza também em Cloudflare Workers → Settings → Variables
#
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
